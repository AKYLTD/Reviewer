  "story": {
    "intro": "From West Hampstead in 1989 to Belsize Village in 2011 — the long version.",
    "milestones": [
      {
        "year": "1989",
        "place": "West Hampstead",
        "body": "Roni Avital opened the first shop on West End Lane with a small kettle, a stone deck oven, and an unfashionable stubbornness about boiling bagels."
      },
      {
        "year": "2011",
        "place": "Belsize Village",
        "body": "The second shop opened on Belsize Lane. Same recipe, longer counter, a small dining room that became a Saturday-morning fixture."
      },
      {
        "year": "2025",
        "place": "The new sign",
        "body": "We took the building back to its bones, kept the bake exactly as it was, and re-cut the shopfront sign."
      }
    ]
  },
