# Square integration (production)
# Get these from https://developer.squareup.com/apps -> your app -> Credentials.
# Use Sandbox tokens during development; Production only in hosting env vars.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Admin
# Set a strong password; this is what you type at /admin to sign in.
ADMIN_PASSWORD=
# 32+ random characters used to sign session cookies. Rotate to invalidate
# every signed-in admin in one go.
ADMIN_SESSION_SECRET=
