# Data source:
#   demo   -- bundled sample dataset (no internet required)
#   live   -- official APIs (Google Places, etc.) - needs keys, costs money
#   scrape -- Playwright-based scraping (free, slower, fragile)
DATA_MODE=demo

# Google Places API key (https://console.cloud.google.com -> Places API).
# Required when DATA_MODE=live for Google reviews + store discovery.
GOOGLE_PLACES_API_KEY=

# Optional: Deliveroo - there is no public review API. The Deliveroo adapter is
# a stub by default; plug in your own scraper / data source endpoint here.
DELIVEROO_FEED_URL=
