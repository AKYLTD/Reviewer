# Copy to .env.local and fill in. The anon key is public (protected by RLS), but
# keep .env.local out of git. These are baked into the static build at `npm run build`.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only, for the one-off recipe import (Task 3). Never ship this.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
