# Hostinger (Apache) config for the single-page app.
# Serve index.html for any path so refreshes/deep links work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # app.js uses a stable name, and index.html is the shell — always revalidate
  # so a re-deploy (overwriting app.js) is picked up immediately.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Static media can be cached long.
  <FilesMatch "\.(woff2?|png|jpe?g|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
